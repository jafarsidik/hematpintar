VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Nomor WhatsApp pembelian manual, contoh: 6281234567890
VITE_WA_NUMBER=
# Domain email sintetis untuk Supabase Auth. Tidak ada email yang dikirim.
VITE_AUTH_EMAIL_DOMAIN=users.hematpintar.local
# true = semua halaman kecuali /login wajib login; false = hanya meta.requiresAuth
VITE_REQUIRE_LOGIN=false
# true = izinkan fitur lupa password (resetPasswordForEmail); false = hubungi admin
VITE_ENABLE_PASSWORD_RESET=false
